                </assert_contents>
            </output>
            <output name="align_log">
             <assert_contents>
                    <has_n_lines n="14"/>
                    <has_text text="Genomes included in the analysis"/>
                    <has_text_matching expression="GCF_000146045.2" />
                    <has_text_matching expression="GCA_000182565.2" />
                    <has_text_matching expression="GCF_000271585.1" />
                    <has_text_matching expression="GCF_000149205.2" />
                    <has_text_matching expression="GCF_000182565.1" />
                    <has_text_matching expression="GCF_000091045.1" />
                    <has_text_matching expression="GCF_000697725.1" />
                    <has_text text="UUCG"/>
             </assert_contents>
             </output>
             <output_collection name="output_directory" type="list:list">
                     <element name="align">
                             <element name="aligned_ACT1">
                                <assert_contents>
					<has_text text=">8215573294074245211"/>
                                        <has_line_matching expression="^[ARNDCEQGHILKMFPSTWYV-]+$"/>
                                </assert_contents>
                             </element>
                     </element>
             </output_collection>
        </test>
    </tests>

    <help><![CDATA[
**UFCG Profile Tool**

Align genes and provide multiple sequence alignments from UFCG (Universal Fungal Core Genes) profiles pipeline.

**Input**
- Input directory containing fungal genome assemblies in UCG format

The options are::

    -a, Alignment method
        - nucleotide : Use given nucleotide sequence (default)
        - protein : Use given amino acid sequence
        - codon : Use codons encrypting given amino acid sequence
        - codon12 : Use codons without third bases
    -l, Tree leaf format, comma-separated string containing one or more of the following keywords
        - uid
        - acc
        - label
        - taxon
        - strain
        - type
        - taxonomy
    -c, Align multiple copied gene (default : 0)
    -f, Gap-rich filter percentage threshold (0 - 100) [50]


**Output**

.. list-table::
   :widths: 10 30 60
   :header-rows: 1

   * - Type
     - Name
     - Description
   * - Align
     - aligned_concatenated.fasta
     - Concatenated sequences of entire core gene alignments
   * -
     - align/aligned_[GENE].fasta
     - Aligned sequences of each single gene
   * -
     - align.log
     - Log file containing information about this run
   * - Misc
     - misc/[GENE]_pro.fasta
     - Aligned protein sequences of each single gene


**Citation**
If you use UFCG in your research, please cite the appropriate publications.
    ]]></help>

        <expand macro="citations"/>

</tool>
