<tool id="kaptive_extract" name="Kaptive 3: Extract Features from Database" version="@TOOL_VERSION@+galaxy0" profile="@PROFILE@">
    <description>Extract loci, genes, or metadata from Kaptive database in various formats</description>
    <macros>
          <import>macros.xml</import>
    </macros>
    <expand macro="requirements"/>
    <command detect_errors="exit_code"><![CDATA[
    #if $output_type == "directory"
        #set $output_path = "kaptive_output"
        mkdir -p '$output_path' &&
    #else
        #set $output_path = "kaptive_output"
        #set $fna_output = "kaptive_output.fna"
        #set $ffn_output = "kaptive_output.ffn"
        #set $faa_output = "kaptive_output.faa"
    #end if

    kaptive extract
        '$db'
        #if $formats.output_type == "directory"
            #if 'fna' in $formats.output_format:
                --fna '$output_path'
            #end if
            #if 'ffn' in $formats.output_format:
                --ffn '$output_path'
            #end if
            #if 'faa' in $formats.output_format:
                --faa '$output_path'
            #end if
        #else
            #if 'fna' in $formats.output_format:
                --fna '$fna_output'
            #end if
            #if 'ffn' in $formats.output_format:
                --ffn '$ffn_output'
            #end if
            #if 'faa' in $formats.output_format:
                --faa '$faa_output'
            #end if
	#end if
	&&
        2>&1
    ]]></command>
    
    <inputs>
	<!-- Database input -->
	<param type="data" name="db" format="genbank" label="Database path or keyword"
               help="Path to the Kaptive database directory or a predefined keyword"/>
        
        <!-- Formats section with multiple select -->
	<section name="formats" title="Output Formats" expanded="true">
            <param name="output_type" type="select" label="Output type">
                <option value="single_file">Single combined fasta file</option>
                <option value="directory">Multiple fasta files in a collection</option>
            </param>
		
            <param name="output_format" type="select" multiple="true" label="Extract locus sequences">
                <option value="fna">Locus nucleotide sequences (FASTA)</option>
                <option value="ffn">Locus gene nucleotide sequences (FASTA)</option>
                <option value="faa">Locus gene protein sequences (FASTA)</option>
            </param>    
        </section>
        
    </inputs>
    
<outputs>
    <!-- For single file output -->
    <data name="output_fna" format="fasta" label="${tool.name} on ${on_string}: Locus nucleotide sequences" from_work_dir="kaptive_output.fna">
        <filter>('fna' in formats["output_format"] and formats["output_type"] == "single_file")</filter>
    </data>
    
    <data name="output_ffn" format="fasta" label="${tool.name} on ${on_string}: Locus gene nucleotide sequences" from_work_dir="kaptive_output.ffn">
        <filter>('ffn' in formats["output_format"] and formats["output_type"] == "single_file")</filter>
    </data>
    
    <data name="output_faa" format="fasta" label="${tool.name} on ${on_string}: Locus gene protein sequences" from_work_dir="kaptive_output.faa">
        <filter>('faa' in formats["output_format"] and formats["output_type"] == "single_file")</filter>
    </data>

    <!-- For directory output - each as a collection -->
    <collection name="output_dir_fna" type="list" label="${tool.name} on ${on_string}: Locus nucleotide sequences (directory)">
        <filter>('fna' in formats["output_format"] and formats["output_type"] == "directory")</filter>
	<discover_datasets pattern="(?P&lt;designation&gt;.+)\.(?P&lt;ext&gt;fna)" directory="kaptive_output" format="fasta" visible="false" />
    </collection>
    
    <collection name="output_dir_ffn" type="list" label="${tool.name} on ${on_string}: Locus gene nucleotide sequences (directory)">
        <filter>('ffn' in formats["output_format"] and formats["output_type"] == "directory")</filter>
        <discover_datasets pattern="(?P&lt;designation&gt;.+)\.(?P&lt;ext&gt;ffn)" directory="kaptive_output" format="fasta" visible="false" />
    </collection>
    
    <collection name="output_dir_faa" type="list" label="${tool.name} on ${on_string}: Locus gene protein sequences (directory)">
        <filter>('faa' in formats["output_format"] and formats["output_type"] == "directory")</filter>
        <discover_datasets pattern="(?P&lt;designation&gt;.+)\.(?P&lt;ext&gt;faa)" directory="kaptive_output" format="fasta" visible="false" />
    </collection>
</outputs>
<tests>
    <!-- Test 1: Single file output with fna -->
