        <param name="output_type" value="single_file"/>
        <param name="output_format" value="fna"/>
        <output name="output_fna" value="9lps.fna" ftype="fasta">
            <assert_contents>
                <has_size value="66761"/>
                <has_line_matching expression="^>.*"/>
                <has_line_matching expression="^[ACGTN]+$"/>
            </assert_contents>
        </output>
    </test>
